@{
}
<br />
<div class="col-10 offset-1 col-md-8 offset-md-2 text-white p-3">
    <div class="row">
        <div class="col-10 offset-1 col-md-8 offset-md-2 text-white text-center p-3">
            <h5 class="mb-4">My Web Browser Games</h5>
            <p>This is just a fun little section in my portfolio where I'll recreate popular retro games and apps for fun that can be played on desktop</p>
        </div>
    </div>
    <div class="row">
        <div class="col-10 offset-1 col-md-6 offset-md-0 text-white mb-4">
            <div class="card bg-dark border border-white h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-warning fw-bolder tektur-font">Snake</h5>
                    <p class="card-text">My recreation of the popular retro game snake! Eat the apple to grow larger, don't crash into yourself</p>
                    <a href="@Url.Action("Snake", "Games")" class="btn btn-primary mb-1 mt-auto">Play Game</a>
                </div>
            </div>
        </div>
        <div class="col-10 offset-1 col-md-6 offset-md-0 text-white mb-4">
            <div class="card bg-dark border border-white h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-warning fw-bolder tektur-font">Highway Hazard</h5>
                    <p class="card-text">My spinoff inspired by the popular app subway surfers, speed down the highway, don't crash!</p>
                    <button class="btn btn-secondary mb-1 mt-auto" disabled>Coming Soon</button>
                </div>
            </div>
        </div>
    </div>
</div>